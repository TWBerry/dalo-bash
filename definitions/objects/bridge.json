{
  "abi": 1,
  "type": "BRIDGE",
  "name": "Bridge",
  "instance_fields": {
    "MODE": {
      "type": "string",
      "required": true,
      "enum": [
        "listen",
        "connect"
      ]
    },
    "PORT": {
      "type": "uint",
      "required": true,
      "min": 1
    },
    "PEER_PORT": {
      "type": "uint",
      "required": false,
      "min": 1
    }
  },
  "ports": {
    "in": {
      "direction": "input",
      "plane": "data",
      "type": "any"
    },
    "out": {
      "direction": "output",
      "plane": "data",
      "type": "any"
    }
  },
  "methods": [
    "summon_worker",
    "on_job_completed"
  ],
  "features": [
    "core",
    "data",
    "worker"
  ],
  "worker": {
    "required": true,
    "default": "bridge"
  },
  "execution": [
    "INLINE",
    "ASYNC",
    "PERSISTENT"
  ]
}
